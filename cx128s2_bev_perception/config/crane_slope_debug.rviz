Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Crane Boundary Clusters1
    - /Crane Boundary Points1
    Splitter Ratio: 0.5
  Tree Height: 280
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: world
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
      laser_link:
        Value: true
      world:
        Value: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Tree:
      world:
        laser_link: {}
    Update Interval: 0
    Value: true
  - Alpha: 0.25
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 150; 150; 150
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: Raw Input Cloud
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /ch/lslidar_point_cloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 150; 150; 150
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Processed Input (world)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.025
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /debug/valid_points
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 0.4
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 120; 120; 120
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Name: Crane Slope Classified
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/classified
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: Crane Boundary Points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.06
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/boundary
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: Crane Boundary Clusters
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.05
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/boundary_clusters
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.9
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: Crane Z-Gaussian Layers
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.04
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/z_gaussian_layers
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: Crane Clusters (Z-Gaussian + BEV Clusterer)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.04
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/clusters
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: Crane Closed-Loop Object Groups (Omega_C)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 5
    Size (m): 0.05
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/closed_loop_groups
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.5
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 100; 100; 100
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Ground Points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/ground
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Autocompute Value Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 165; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Non-Ground Points
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /crane_slope/non_ground
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Crane Hook Chain & Markers
    Namespaces:
      {}
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /crane_hook/markers
    Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current View:
      Class: rviz_default_plugins/Orbit
      Distance: 20.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.0
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.60
      Target Frame: world
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.71
